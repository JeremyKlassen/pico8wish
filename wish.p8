--start
function _init()
	state = "shop"
end

function _update()
	if state == "shop" then
		update_shop()
	elseif state == "pause" then
		update_pause()
	end
end

function _draw()
	if state == "shop" then
		draw_shop()
	elseif state == "pause" then
		draw_pause()
	end
	cls()
	map()
	
end
